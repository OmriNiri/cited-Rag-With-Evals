# Copy to .env and adjust: cp .env.example .env
# .env is gitignored; this file documents every variable the app reads.

# --- Used now (Phase 0) ---

# PostgreSQL connection string. Matches the credentials in docker-compose.yml.
DATABASE_URL=postgres://rag:rag@localhost:5432/rag

# HTTP port for the NestJS API (default 3000).
PORT=3000

# --- Answering (POST /ask, npm run ask). Only checked when answering starts,
#     so ingest/search work without these. ---

# OpenAI-compatible chat endpoint. Default: local Ollama.
LLM_BASE_URL=http://localhost:11434/v1
# Empty for Ollama; set it when pointing LLM_BASE_URL at a hosted provider.
LLM_API_KEY=
# Model name as the server knows it. Chosen in Phase 3 (see DECISIONS): `ollama pull llama3.1:8b`
LLM_MODEL=llama3.1:8b
# Max time to wait for one model answer, in milliseconds (default 60000).
LLM_TIMEOUT_MS=60000
